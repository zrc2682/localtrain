{
  "name": "localtrain",
  "version": "0.1.0",
  "private": true,
  "description": "本地 CTF / CVE 复现靶场（仅供本地使用）",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev -w packages/server",
    "dev:web": "npm run dev -w packages/web",
    "build": "npm run build -w packages/web",
    "db:push": "npm run db:push -w packages/server",
    "db:seed": "npm run db:seed -w packages/server",
    "setup": "npm install && npm run db:push && npm run db:seed"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
